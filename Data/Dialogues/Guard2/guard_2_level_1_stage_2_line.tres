[resource]
script = ExtResource("1_1aaj6")
text = "Старый распорядок можете выбросить. После тревоги король и ест, и спит в тронном зале. Меня оставили при дверях, остальных по новому указу отправили к стенам. На бумаге дворец защищён лучше прежнего, а внутри людей почти нет."
speaker = ExtResource("3_xmbwn")
