[sub_resource type="Resource" id="EndingRequest"]
script = ExtResource("ending_request")
side = 1

[sub_resource type="Resource" id="Line"]
script = ExtResource("2")
text = "Значит, нам достался устаревший чертёж. На трёх метрах мы вскроем затопленный ров. Остановлю проходку: добудем кирки и крепления, проверим грунт и пройдём ниже дна. Придётся отложить нападение. Люди важнее назначенного часа."
speaker = ExtResource("3")

[resource]
script = ExtResource("1")
dialogue_id = "Headman_lvl_1_stage_3_victory"
character = ExtResource("3")
lines = Array[ExtResource("2")]([SubResource("Line")])
