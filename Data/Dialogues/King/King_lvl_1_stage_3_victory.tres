[sub_resource type="Resource" id="Resource_reply"]
script = ExtResource("2_line")
text = "Подкоп из таверны… Так вот почему они до сих пор не показались у ворот. Вы вовремя заговорили. Я прикажу обыскать таверну и выставить людей под тронным залом. Пусть идут — мы их встретим."
speaker = ExtResource("3_king")

