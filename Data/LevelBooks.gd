static func get_books(level: int, stage: int) -> Array:

	if level < 0 or level >= BOOKS_BY_LEVEL.size():
		return []


	var level_data: Dictionary = BOOKS_BY_LEVEL[level]


	match stage:

		1:
			return level_data.get(1, [])

		2:
			return level_data.get(2, [])

		3:
			return level_data.get(1, []) + level_data.get(2, [])

		_:
			return []
