static func get_books(level: int, stage: int) -> Array:
	if level < 0 or level >= BOOKS_BY_LEVEL.size(): return []
	if stage == 2: return BOOKS_BY_LEVEL[level][0] + BOOKS_BY_LEVEL[level][1]
	return BOOKS_BY_LEVEL[level].get(stage, [])
