
#!/usr/bin/env python

import os

env = Environment(tools=["default"], PLATFORM="")

env = SConscript(
    "godot-cpp/SConstruct",
    {
        "env": env,
        "api_version": "4.7",
    }
)

env.Append(CPPPATH=["src/"])
env.Append(LIBS=["User32"])

sources = Glob("src/*.cpp")

objects = []

for source in sources:
    object_name = os.path.splitext(os.path.basename(str(source)))[0]
    obj = env.Object(
        target="build/windows/" + object_name,
        source=source
    )
    objects.append(obj)

library = env.SharedLibrary(
    "bin/windows/resolution_manager",
    source=objects,
)

Default(library)
