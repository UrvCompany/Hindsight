; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hindsight"
run/main_scene="uid://242r32dcegnm"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

CursorManager="*res://Autoload/cursor_manager.gd"
SceneStateGlobal="*uid://jkkxhebkg8rk"
SupportingSceneManager="*res://Autoload/supporting_scene_manager.tscn"
DialogueManager="*uid://dpihlkl8qbc3y"
SaveManager="*uid://bny4v85lw548c"
EndingManager="*res://Autoload/ending_manager.gd"
MusicManager="*uid://h62wffne5htm"
SettingsManager="*uid://ddxggoviwk0ui"

[copy_files_on_export]

files=Array[PackedStringArray]([PackedStringArray("res://ThirdPartyLicenses", "ThirdPartyLicenses", "")])

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Hindsight"

[editor_plugins]

enabled=PackedStringArray("res://addons/copy_files_on_export/plugin.cfg")

[gui]

theme/custom="uid://cd5k1vyswud6y"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
